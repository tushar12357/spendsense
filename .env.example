# Environment variables — copy to .env and fill in your values
# Never commit .env to version control

# ─── Application ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── PostgreSQL (development) ───────────────────────────────
POSTGRES_USER=spendsense
POSTGRES_PASSWORD=spendsense_dev
POSTGRES_DB=spendsense
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://spendsense:spendsense_dev@localhost:5432/spendsense?schema=public"

# ─── PostgreSQL (test — separate container) ─────────────────
TEST_POSTGRES_USER=spendsense_test
TEST_POSTGRES_PASSWORD=spendsense_test
TEST_POSTGRES_DB=spendsense_test
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5433
TEST_DATABASE_URL="postgresql://spendsense_test:spendsense_test@localhost:5433/spendsense_test?schema=public"

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=replace_with_at_least_64_chars_random_secret_do_not_use_in_production
JWT_EXPIRES_IN=7d

# ─── File Uploads ────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_TEMP_DIR=./tmp/uploads

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20
