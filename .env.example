# Copy to .env and adjust. Never commit .env. Every value below is a placeholder.
# Variables are validated at startup (src/config/env.ts): the app refuses to boot if one is invalid.

# ─── Application ────────────────────────────────────────────
NODE_ENV=development            # development | test | production
PORT=5000
LOG_LEVEL=info                  # trace | debug | info | warn | error | fatal | silent
# Comma-separated browser origins allowed by CORS. REQUIRED when NODE_ENV=production.
ALLOWED_ORIGINS=http://localhost:3000
# Number of reverse-proxy hops in front of the API (1 behind one load balancer). Needed for correct
# per-client rate limiting; leave 0 when the API is exposed directly.
TRUST_PROXY=0

# ─── PostgreSQL (development) ───────────────────────────────
# Used by docker-compose.yml to create the container...
POSTGRES_USER=spendsense
POSTGRES_PASSWORD=spendsense_dev
POSTGRES_DB=spendsense
POSTGRES_PORT=5432
# ...and by the app / Prisma to connect.
DATABASE_URL="postgresql://spendsense:spendsense_dev@localhost:5432/spendsense?schema=public"
# Queries slower than this are logged (parameters are never logged).
SLOW_QUERY_MS=200

# ─── PostgreSQL (tests: a separate container, truncated between tests) ───
TEST_POSTGRES_USER=spendsense_test
TEST_POSTGRES_PASSWORD=spendsense_test
TEST_POSTGRES_DB=spendsense_test
TEST_POSTGRES_PORT=5433
TEST_DATABASE_URL="postgresql://spendsense_test:spendsense_test@localhost:5433/spendsense_test?schema=public"

# ─── Redis (BullMQ background imports) ──────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Authentication ─────────────────────────────────────────
# At least 32 random characters, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── Statement imports ──────────────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_TEMP_DIR=./tmp/uploads
# false: the API processes uploads inline and answers 201 with the result (simple, no Redis needed).
# true:  the API queues the import in BullMQ and answers 202; run `npm run worker` to process jobs.
IMPORT_ASYNC=false
IMPORT_JOB_ATTEMPTS=3           # total tries per job, with exponential backoff
IMPORT_JOB_BACKOFF_MS=5000      # first retry delay; doubles each time
WORKER_CONCURRENCY=2
IMPORT_STALE_AFTER_MS=900000    # a PENDING/PROCESSING batch silent this long may be re-run

# ─── Rate limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300     # per IP, whole API
AUTH_RATE_LIMIT_MAX=20          # per IP, login/register/change-password
