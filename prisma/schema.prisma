// prisma/schema.prisma
// SpendSense database schema.
// Managed by Prisma Migrate — never edit applied migrations directly.
// Monetary fields use Decimal(14,2) — sufficient for INR values up to 999,999,999,999.99.
// All timestamps are TIMESTAMPTZ (stored UTC-normalized).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enumerations
// ─────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
}

enum ImportStatus {
  PENDING      // batch registered, processing not started
  PROCESSING   // worker picked it up
  COMPLETED    // all rows processed (some may be rejected/duplicate)
  FAILED       // unrecoverable batch failure
  PARTIAL      // processing stopped mid-way; can be retried
}

enum ImportRowStatus {
  ACCEPTED
  DUPLICATE
  SKIPPED    // intentionally ignored (e.g., header or summary row)
  REJECTED   // validation failure
}

enum AccountType {
  SAVINGS
  CURRENT
  CREDIT_CARD
  WALLET
  CASH
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  CANCELLED
}

// ─────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  /// IANA timezone string, e.g. "Asia/Kolkata". Used for month boundary calculations.
  timezone     String   @default("Asia/Kolkata")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  importBatches ImportBatch[]
  merchantRules MerchantRule[]
  budgets      Budget[]
  savingsGoals SavingsGoal[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Accounts
// ─────────────────────────────────────────────

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  name           String
  type           AccountType
  currency       String      @default("INR") @db.Char(3)
  /// User-confirmed opening balance. Used as the basis for safe-to-spend calculations.
  openingBalance Decimal     @default(0) @map("opening_balance") @db.Decimal(14, 2)
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  importBatches ImportBatch[]

  /// Prevents accidental creation of two accounts with identical names for the same user.
  @@unique([userId, name])
  /// Target of composite FKs on transactions / import_batches so a row can never
  /// reference an account owned by a different user (enforced by the database).
  @@unique([id, userId])
  @@index([userId])
  @@map("accounts")
}

// ─────────────────────────────────────────────
// Categories
// ─────────────────────────────────────────────

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  /// NULL for system-wide categories visible to all users.
  userId   String? @map("user_id") @db.Uuid
  name     String
  /// Optional parent for two-level hierarchy (e.g., Food → Dining Out).
  parentId String? @map("parent_id") @db.Uuid
  icon     String?
  color    String?
  isSystem Boolean @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[]    @relation("CategoryHierarchy")
  transactions  Transaction[]
  merchantRules MerchantRule[]
  budgets       Budget[]

  /// A user cannot have two categories with the same name.
  /// System categories (userId = NULL) rely on a partial unique index in migration.
  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

// ─────────────────────────────────────────────
// Merchant Rules
// Auto-categorization rules defined per user.
// ─────────────────────────────────────────────

model MerchantRule {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// Case-insensitive substring matched against the transaction description.
  /// (Deliberately not a regex: user-supplied regexes are a ReDoS risk.)
  pattern        String
  categoryId     String   @map("category_id") @db.Uuid
  /// Canonical merchant name to assign after matching.
  normalizedName String?  @map("normalized_name")
  /// Higher priority rules are checked first.
  priority       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId, priority(sort: Desc)])
  @@map("merchant_rules")
}

// ─────────────────────────────────────────────
// Transactions
// The core financial ledger.
// ─────────────────────────────────────────────

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  accountId   String          @map("account_id") @db.Uuid
  categoryId  String?         @map("category_id") @db.Uuid
  type        TransactionType
  /// Always stored as a positive value. Type determines direction.
  amount      Decimal         @db.Decimal(14, 2)
  currency    String          @default("INR") @db.Char(3)
  /// When the transaction occurred (statement date/time), not when it was imported.
  occurredAt  DateTime        @map("occurred_at") @db.Timestamptz
  description String
  /// Normalized merchant name (may be set by merchant rule or user correction).
  merchantName String?        @map("merchant_name")
  notes       String?
  /// Bank-provided reference/UTR number. Used for primary duplicate detection.
  sourceTxId  String?         @map("source_tx_id")
  /// Content fingerprint for secondary duplicate detection (see fingerprint.ts).
  fingerprint String?
  importRowId String?         @unique @map("import_row_id") @db.Uuid
  /// For TRANSFER type: links the corresponding counterpart transaction.
  transferPeerId String?      @map("transfer_peer_id") @db.Uuid
  isReviewed  Boolean         @default(false) @map("is_reviewed")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId, userId], references: [id, userId])
  category     Category?    @relation(fields: [categoryId], references: [id])
  importRow    ImportRow?   @relation("TransactionImportRow", fields: [importRowId], references: [id])
  linkedImportRow ImportRow? @relation("ImportRowTransaction")
  transferPeer Transaction? @relation("TransferPair", fields: [transferPeerId], references: [id])
  transferPeerOf Transaction[] @relation("TransferPair")

  /// Primary duplicate guard: same bank reference cannot appear twice on the same account.
  @@unique([accountId, sourceTxId], name: "unique_account_source_tx")
  @@index([userId, occurredAt(sort: Desc)])      // primary query pattern: user's ledger by date
  @@index([userId, type])                        // type filter
  @@index([userId, categoryId])                  // category analytics
  @@index([accountId, occurredAt(sort: Desc)])   // account-scoped ledger
  @@index([accountId, fingerprint])              // fingerprint lookup for duplicate detection
  @@map("transactions")
}

// ─────────────────────────────────────────────
// Import Batches
// One record per CSV file uploaded.
// ─────────────────────────────────────────────

model ImportBatch {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  accountId   String       @map("account_id") @db.Uuid
  fileName    String       @map("file_name")
  /// SHA-256 of the uploaded file bytes. Used to detect repeated uploads.
  fileHash    String       @map("file_hash")
  /// Identifies which CSV adapter was used, e.g. "hdfc-csv".
  adapterKey  String       @map("adapter_key")
  status      ImportStatus @default(PENDING)
  totalRows   Int          @default(0) @map("total_rows")
  acceptedRows Int         @default(0) @map("accepted_rows")
  duplicateRows Int        @default(0) @map("duplicate_rows")
  rejectedRows Int         @default(0) @map("rejected_rows")
  skippedRows Int          @default(0) @map("skipped_rows")
  warningCount Int         @default(0) @map("warning_count")
  /// Number of processing attempts (worker retries / re-uploads of a failed file).
  attempts    Int          @default(0)
  /// Structured error metadata (e.g. adapter parse failure reason).
  errorMeta   Json?        @map("error_meta")
  startedAt   DateTime?    @map("started_at") @db.Timestamptz
  completedAt DateTime?    @map("completed_at") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId, userId], references: [id, userId])
  rows    ImportRow[]

  /// Prevents the same file from creating a second batch for the same user.
  @@unique([userId, fileHash], name: "unique_user_file_hash")
  @@index([userId, createdAt(sort: Desc)])
  @@map("import_batches")
}

// ─────────────────────────────────────────────
// Import Rows
// One record per CSV data row in the uploaded file.
// ─────────────────────────────────────────────

model ImportRow {
  id        String          @id @default(uuid()) @db.Uuid
  batchId   String          @map("batch_id") @db.Uuid
  /// 1-indexed position in the source CSV (not counting header row).
  rowNumber Int             @map("row_number")
  /// Original CSV columns as key-value pairs. Treated as sensitive; do not log.
  rawData   Json            @map("raw_data")
  /// Parsed and normalized fields ready for transaction insertion.
  normalizedData Json?      @map("normalized_data")
  status    ImportRowStatus
  /// Human-readable reason for DUPLICATE / SKIPPED / REJECTED status.
  reason    String?
  /// Set when status = ACCEPTED and transaction was persisted.
  transactionId String?     @unique @map("transaction_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation("ImportRowTransaction", fields: [transactionId], references: [id])
  linkedTransaction Transaction? @relation("TransactionImportRow")

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@map("import_rows")
}

// ─────────────────────────────────────────────
// Budgets
// Monthly spending limit per category.
// ─────────────────────────────────────────────

model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  /// Always the first day of the month (DATE). e.g. 2024-03-01.
  periodMonth DateTime @map("period_month") @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("INR") @db.Char(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  /// One budget per user per category per month.
  @@unique([userId, categoryId, periodMonth])
  @@index([userId, periodMonth])
  @@map("budgets")
}

// ─────────────────────────────────────────────
// Savings Goals
// ─────────────────────────────────────────────

model SavingsGoal {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  name          String
  targetAmount  Decimal    @map("target_amount") @db.Decimal(14, 2)
  currentAmount Decimal    @default(0) @map("current_amount") @db.Decimal(14, 2)
  currency      String     @default("INR") @db.Char(3)
  targetDate    DateTime?  @map("target_date") @db.Date
  status        GoalStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("savings_goals")
}
